<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, maximum-scale=1.0, user-scalable=no">
<meta name="theme-color" content="#efe9e1">
<title>Snowfall · 猫咪的角落</title>
<style>
/* ========== INS 风主题 ========== */
:root {
    --bg: #efe9e1; --bg-soft: #f7f3ed; --surface: #ffffff; --text: #2a2724;
    --text-dim: #8c857d; --text-soft: #b5ada4; --accent: #b8927a;
    --accent-soft: rgba(184, 146, 122, 0.12); --border: #e8e2da;
    --radius-lg: 22px; --radius: 16px; --radius-sm: 10px;
    --shadow: 0 2px 24px rgba(60, 50, 40, 0.05);
    --shadow-hover: 0 8px 32px rgba(60, 50, 40, 0.09);
    --font-serif: "Playfair Display", "Songti SC", "Noto Serif SC", Georgia, "Times New Roman", serif;
    --font-sans: -apple-system, BlinkMacSystemFont, "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Helvetica Neue", Helvetica, Arial, sans-serif;
    --safe-top: env(safe-area-inset-top, 0px); --safe-bottom: env(safe-area-inset-bottom, 0px);
}
* { margin: 0; padding: 0; box-sizing: border-box; -webkit-tap-highlight-color: transparent; }
html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; text-size-adjust: 100%; }
body {
    font-family: var(--font-sans); background: var(--bg); color: var(--text);
    min-height: 100vh; min-height: -webkit-fill-available; min-height: 100dvh;
    padding: calc(36px + var(--safe-top)) 20px calc(80px + var(--safe-bottom));
    -webkit-font-smoothing: antialiased; letter-spacing: 0.01em; position: relative; overflow-x: hidden;
}
body::before {
    content: ''; position: fixed; top: -30vh; left: 50%; transform: translateX(-50%);
    width: 90vw; height: 70vh; background: radial-gradient(ellipse at center, rgba(255, 250, 240, 0.9) 0%, transparent 65%);
    pointer-events: none; z-index: 0;
}
body.no-scroll { position: fixed; width: 100%; height: 100%; overflow: hidden; }
#snow { position: fixed; top: 0; left: 0; width: 100%; height: 100%; pointer-events: none; z-index: 10; }
.shell { max-width: 760px; margin: 0 auto; position: relative; z-index: 1; }

/* 顶栏 */
.nav { display: flex; justify-content: space-between; align-items: center; margin-bottom: 56px; padding: 0 4px; }
.nav .brand { font-family: var(--font-serif); font-size: 17px; font-weight: 600; letter-spacing: 0.08em; display: flex; align-items: center; gap: 8px; }
.nav .brand .paw-icon { width: 20px; height: 20px; color: var(--accent); flex-shrink: 0; }
.nav .brand span.dot { color: var(--accent); }
.nav .actions { display: flex; gap: 8px; }
.nav button { background: var(--surface); border: 1px solid var(--border); color: var(--text-dim); width: 40px; height: 40px; border-radius: 50%; font-size: 16px; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: all 0.3s; padding: 0; -webkit-appearance: none; appearance: none; }
.nav button .paw-mini { width: 18px; height: 18px; }
.nav button:hover, .nav button:active { border-color: var(--accent); color: var(--accent); }
.nav button.off { opacity: 0.4; }

/* Hero */
.hero { text-align: center; margin-bottom: 64px; padding: 0 12px; }
.hero .eyebrow { font-size: 10px; letter-spacing: 0.35em; text-transform: uppercase; color: var(--text-soft); margin-bottom: 28px; display: flex; align-items: center; justify-content: center; gap: 10px; }
.hero .eyebrow .paw-tiny { width: 12px; height: 12px; color: var(--text-soft); opacity: 0.6; }
.hero h1 { font-family: var(--font-serif); font-size: clamp(28px, 6vw, 46px); font-weight: 500; line-height: 1.4; margin-bottom: 20px; }
.hero h1 em { font-style: italic; color: var(--accent); }
.hero .subtitle { font-size: 13px; color: var(--text-dim); line-height: 1.9; letter-spacing: 0.05em; }
.hero .divider { display: inline-flex; align-items: center; gap: 8px; color: var(--text-soft); margin-top: 24px; }
.hero .divider::before, .hero .divider::after { content: ''; width: 24px; height: 1px; background: var(--text-soft); }
.hero .divider .paw-tiny { width: 12px; height: 12px; }

/* 卡片网格 */
.grid { display: grid; grid-template-columns: 1.2fr 1fr 1fr; gap: 16px; margin-bottom: 56px; }
.card { background: var(--surface); border-radius: var(--radius-lg); padding: 28px 24px; box-shadow: var(--shadow); transition: box-shadow 0.35s, transform 0.35s; position: relative; }
.card:hover { box-shadow: var(--shadow-hover); transform: translateY(-2px); }
.card .label { font-size: 9px; letter-spacing: 0.22em; text-transform: uppercase; color: var(--text-soft); margin-bottom: 16px; display: flex; align-items: center; justify-content: center; gap: 6px; }
.card .label .paw-tiny { width: 10px; height: 10px; color: var(--accent); opacity: 0.5; }
.card-profile { text-align: center; }
.card-profile .avatar { width: 72px; height: 72px; border-radius: 50%; background: var(--bg-soft); border: 3px solid var(--surface); outline: 1px solid var(--border); margin: 0 auto 16px; display: flex; align-items: center; justify-content: center; overflow: hidden; color: var(--accent); }
.card-profile .avatar img { width: 100%; height: 100%; object-fit: cover; }
.card-profile .avatar .paw-lg { width: 36px; height: 36px; }
.card-profile h2 { font-family: var(--font-serif); font-size: 20px; font-weight: 500; margin-bottom: 8px; }
.card-profile .sig { font-size: 12px; color: var(--text-dim); line-height: 1.8; }
.card-anniv { text-align: center; }
.card-anniv .days { font-family: var(--font-serif); font-size: 40px; font-weight: 500; color: var(--accent); line-height: 1; margin: 4px 0; }
.card-anniv .unit { font-size: 11px; color: var(--text-soft); letter-spacing: 0.15em; margin-bottom: 14px; }
.card-anniv .anniv-name { font-size: 11px; color: var(--text-dim); padding-top: 14px; border-top: 1px solid var(--border); }
.card-weather { text-align: center; }
.card-weather .weather-icon { font-size: 32px; margin-bottom: 6px; display: block; line-height: 1.2; }
.card-weather .temp { font-family: var(--font-serif); font-size: 34px; font-weight: 500; line-height: 1; margin-bottom: 6px; }
.card-weather .weather-text { font-size: 11px; color: var(--text-dim); margin-bottom: 14px; }
.card-weather .clock { padding-top: 14px; border-top: 1px solid var(--border); display: flex; justify-content: space-between; font-size: 10px; color: var(--text-soft); letter-spacing: 0.08em; }

/* 分栏 */
.section-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 24px; padding: 0 4px; }
.section-head h2 { font-family: var(--font-serif); font-size: 18px; font-weight: 500; display: flex; align-items: center; gap: 8px; }
.section-head h2 .paw-sm { width: 16px; height: 16px; color: var(--accent); }
.section-head .count { font-size: 10px; color: var(--text-soft); letter-spacing: 0.2em; }
.columns { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; margin-bottom: 56px; }
.column-card { background: var(--surface); border-radius: var(--radius-lg); padding: 28px 24px; box-shadow: var(--shadow); transition: all 0.35s; position: relative; overflow: hidden; }
.column-card:hover { box-shadow: var(--shadow-hover); transform: translateY(-3px); }
.column-card .num { font-family: var(--font-serif); font-size: 11px; color: var(--accent); letter-spacing: 0.15em; margin-bottom: 14px; display: flex; align-items: center; gap: 6px; }
.column-card .num .paw-tiny { width: 10px; height: 10px; color: var(--accent); opacity: 0.6; }
.column-card h3 { font-family: var(--font-serif); font-size: 17px; font-weight: 500; margin-bottom: 10px; }
.column-card p { font-size: 13px; color: var(--text-dim); line-height: 1.8; word-break: break-word; }
.column-card img { width: calc(100% + 48px); margin: -28px -24px 18px; display: block; height: 130px; object-fit: cover; }

/* 留言板 */
.guestbook { background: var(--surface); border-radius: var(--radius-lg); padding: 36px 32px; box-shadow: var(--shadow); margin-bottom: 48px; }
.guestbook h2 { font-family: var(--font-serif); font-size: 22px; font-weight: 500; margin-bottom: 6px; display: flex; align-items: center; gap: 10px; }
.guestbook h2 .paw-sm { width: 20px; height: 20px; color: var(--accent); }
.guestbook .sub { font-size: 12px; color: var(--text-dim); margin-bottom: 28px; }
.guestbook form { display: grid; grid-template-columns: 1fr 1.6fr auto; gap: 10px; margin-bottom: 28px; }
.guestbook input { background: var(--bg-soft); border: 1px solid transparent; border-radius: 100px; padding: 14px 20px; color: var(--text); font-family: var(--font-sans); font-size: 16px; outline: none; transition: all 0.3s; width: 100%; -webkit-appearance: none; appearance: none; }
.guestbook input::placeholder { color: var(--text-soft); }
.guestbook input:focus { background: var(--surface); border-color: var(--accent); }
.guestbook button[type="submit"] { background: var(--text); color: var(--surface); border: none; border-radius: 100px; padding: 14px 24px; font-size: 13px; font-weight: 500; letter-spacing: 0.1em; cursor: pointer; font-family: var(--font-sans); transition: all 0.3s; white-space: nowrap; -webkit-appearance: none; appearance: none; display: flex; align-items: center; gap: 6px; justify-content: center; }
.guestbook button[type="submit"]:hover, .guestbook button[type="submit"]:active { background: var(--accent); }

.msg-item { padding: 18px 0; border-bottom: 1px solid var(--border); display: flex; gap: 14px; align-items: flex-start; }
.msg-item:last-child { border-bottom: none; }
.msg-item .msg-avatar { width: 36px; height: 36px; border-radius: 50%; background: var(--accent-soft); color: var(--accent); display: flex; align-items: center; justify-content: center; flex-shrink: 0; overflow: hidden; }
.msg-item .msg-avatar .paw-sm { width: 18px; height: 18px; }
.msg-item .msg-content { flex: 1; min-width: 0; }
.msg-item .msg-name { font-size: 12px; font-weight: 600; margin-bottom: 4px; word-break: break-word; }
.msg-item .msg-body { font-size: 13px; color: var(--text-dim); line-height: 1.75; word-break: break-word; }
.msg-item .msg-time { font-size: 10px; color: var(--text-soft); margin-top: 6px; letter-spacing: 0.05em; }

.empty-hint { text-align: center; padding: 32px 20px; font-size: 12px; color: var(--text-soft); letter-spacing: 0.08em; display: flex; flex-direction: column; align-items: center; gap: 12px; }
.empty-hint .paw-md { width: 28px; height: 28px; color: var(--accent); opacity: 0.3; }

.site-footer { text-align: center; font-size: 11px; color: var(--text-soft); letter-spacing: 0.3em; padding-top: 24px; display: flex; align-items: center; justify-content: center; gap: 12px; }
.site-footer .paw-tiny { width: 12px; height: 12px; color: var(--accent); opacity: 0.5; }

/* Modal */
.modal { position: fixed; inset: 0; z-index: 100; display: none; align-items: center; justify-content: center; padding: 20px; }
.modal.open { display: flex; }
.modal-backdrop { position: absolute; inset: 0; background: rgba(40, 30, 20, 0.4); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); animation: fadeIn 0.25s ease; cursor: pointer; }
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
.modal-panel { position: relative; background: var(--surface); border-radius: var(--radius-lg); padding: 32px; max-width: 520px; width: 100%; max-height: 88vh; overflow-y: auto; -webkit-overflow-scrolling: touch; overscroll-behavior: contain; box-shadow: 0 20px 60px rgba(40, 30, 20, 0.25); animation: modalIn 0.3s cubic-bezier(0.2, 0.9, 0.3, 1.1); }
@keyframes modalIn { from { opacity: 0; transform: scale(0.96) translateY(12px); } to { opacity: 1; transform: scale(1) translateY(0); } }
.modal-panel h2 { font-family: var(--font-serif); font-size: 22px; font-weight: 500; margin-bottom: 6px; display: flex; align-items: center; gap: 10px; }
.modal-panel h2 .paw-sm { width: 20px; height: 20px; color: var(--accent); }
.modal-sub { font-size: 12px; color: var(--text-dim); margin-bottom: 24px; }
.modal-panel label { display: block; font-size: 11px; color: var(--text-dim); margin-bottom: 8px; letter-spacing: 0.08em; text-transform: uppercase; }
.modal-panel input[type="text"], .modal-panel input[type="password"], .modal-panel input[type="date"], .modal-panel input[type="url"], .modal-panel textarea { width: 100%; background: var(--bg-soft); border: 1px solid transparent; border-radius: var(--radius-sm); padding: 14px 16px; color: var(--text); font-family: var(--font-sans); font-size: 16px; margin-bottom: 18px; outline: none; transition: all 0.3s; -webkit-appearance: none; appearance: none; }
.modal-panel input:focus, .modal-panel textarea:focus { background: var(--surface); border-color: var(--accent); }
.modal-panel textarea { resize: vertical; min-height: 70px; }

.color-row { display: flex; gap: 10px; margin-bottom: 18px; flex-wrap: wrap; }
.color-swatch { width: 36px; height: 36px; border-radius: 50%; cursor: pointer; border: 2px solid transparent; transition: all 0.25s; padding: 0; -webkit-appearance: none; appearance: none; }
.color-swatch:hover { transform: scale(1.08); }
.color-swatch.active { border-color: var(--text); transform: scale(1.08); box-shadow: 0 0 0 2px var(--surface) inset; }

.tabs { display: flex; gap: 4px; margin-bottom: 24px; border-bottom: 1px solid var(--border); overflow-x: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
.tabs::-webkit-scrollbar { display: none; }
.tab-btn { background: none; border: none; padding: 10px 16px; font-family: var(--font-sans); font-size: 12px; color: var(--text-dim); cursor: pointer; letter-spacing: 0.08em; position: relative; transition: color 0.25s; white-space: nowrap; flex-shrink: 0; -webkit-appearance: none; appearance: none; }
.tab-btn.active { color: var(--text); }
.tab-btn.active::after { content: ''; position: absolute; bottom: -1px; left: 16px; right: 16px; height: 2px; background: var(--accent); border-radius: 2px; }

.dialog-actions { display: flex; gap: 10px; margin-top: 8px; flex-wrap: wrap; }
.dialog-actions .primary { background: var(--text); color: var(--surface); border: none; border-radius: 100px; padding: 14px 26px; font-size: 13px; font-weight: 500; letter-spacing: 0.1em; cursor: pointer; font-family: var(--font-sans); transition: all 0.3s; -webkit-appearance: none; appearance: none; display: inline-flex; align-items: center; gap: 6px; }
.dialog-actions .primary:hover, .dialog-actions .primary:active { background: var(--accent); }
.dialog-actions .ghost { background: transparent; color: var(--text-dim); border: 1px solid var(--border); border-radius: 100px; padding: 14px 26px; font-size: 13px; cursor: pointer; font-family: var(--font-sans); letter-spacing: 0.05em; transition: all 0.3s; -webkit-appearance: none; appearance: none; }
.dialog-actions .ghost:hover, .dialog-actions .ghost:active { border-color: var(--accent); color: var(--accent); }

.upload-preview { width: 100%; height: 96px; border: 1px dashed var(--border); border-radius: var(--radius); display: flex; align-items: center; justify-content: center; font-size: 11px; color: var(--text-soft); margin-bottom: 10px; overflow: hidden; background: var(--bg-soft); letter-spacing: 0.08em; }
.upload-preview img { width: 100%; height: 100%; object-fit: cover; }
.upload-status { font-size: 10px; color: var(--text-soft); margin-bottom: 18px; letter-spacing: 0.05em; line-height: 1.6; }
input[type="file"] { font-size: 13px; font-family: var(--font-sans); color: var(--text-dim); margin-bottom: 8px; max-width: 100%; }

.column-row { background: var(--bg-soft); border-radius: var(--radius); padding: 12px; margin-bottom: 8px; }
.column-row .fields { display: grid; gap: 6px; margin-bottom: 8px; }
.column-row input { margin-bottom: 0 !important; background: var(--surface) !important; font-size: 14px !important; padding: 10px 12px !important; }
.column-row .controls { display: flex; gap: 6px; justify-content: flex-end; }
.column-row .controls button { background: var(--surface); border: 1px solid var(--border); color: var(--text-dim); width: 36px; height: 36px; border-radius: 8px; cursor: pointer; font-size: 14px; display: flex; align-items: center; justify-content: center; transition: all 0.25s; padding: 0; -webkit-appearance: none; appearance: none; }
.column-row .controls button:hover, .column-row .controls button:active { border-color: var(--accent); color: var(--accent); }
.column-row .controls button:disabled { opacity: 0.3; cursor: not-allowed; }

.toast { position: fixed; bottom: calc(36px + var(--safe-bottom)); left: 50%; transform: translateX(-50%) translateY(16px); background: var(--text); color: var(--surface); padding: 12px 26px; border-radius: 100px; font-size: 12px; letter-spacing: 0.05em; opacity: 0; pointer-events: none; transition: all 0.4s cubic-bezier(0.2, 0.9, 0.3, 1.2); z-index: 999; box-shadow: 0 8px 24px rgba(40, 30, 20, 0.2); max-width: calc(100% - 40px); text-align: center; }
.toast.show { opacity: 1; transform: translateX(-50%) translateY(0); }

.paw-icon, .paw-lg, .paw-md, .paw-sm, .paw-tiny, .paw-mini { display: inline-block; vertical-align: middle; fill: currentColor; }

/* Gist 配置卡片 */
.gist-card { background: var(--bg-soft); border-radius: var(--radius); padding: 16px; margin-bottom: 18px; }
.gist-card .status { display: flex; align-items: center; gap: 8px; font-size: 12px; color: var(--text-dim); margin-bottom: 12px; }
.gist-card .status .dot { width: 8px; height: 8px; border-radius: 50%; background: #d4786e; flex-shrink: 0; }
.gist-card .status .dot.on { background: #7bb87b; }

@media (max-width: 640px) {
    body { padding: calc(24px + var(--safe-top)) 14px calc(60px + var(--safe-bottom)); }
    .nav { margin-bottom: 40px; }
    .hero { margin-bottom: 44px; }
    .hero h1 { font-size: 30px; }
    .grid { grid-template-columns: 1fr; gap: 12px; }
    .guestbook { padding: 28px 22px; }
    .guestbook form { grid-template-columns: 1fr; }
    .guestbook button[type="submit"] { padding: 16px 24px; }
    .columns { grid-template-columns: 1fr; }
    .card { padding: 24px 20px; }
    .column-card { padding: 24px 20px; }
    .modal { padding: 0; align-items: flex-end; }
    .modal-panel { border-radius: 22px 22px 0 0; max-height: 92vh; padding: 24px 20px calc(24px + var(--safe-bottom)); animation: sheetIn 0.35s cubic-bezier(0.2, 0.9, 0.3, 1); max-width: 100%; }
    @keyframes sheetIn { from { transform: translateY(100%); } to { transform: translateY(0); } }
    .dialog-actions { flex-direction: column-reverse; }
    .dialog-actions .primary, .dialog-actions .ghost { width: 100%; justify-content: center; }
}
@media (max-width: 380px) { .hero h1 { font-size: 26px; } .card-anniv .days { font-size: 34px; } .card-weather .temp { font-size: 30px; } .nav .brand { font-size: 15px; } }
@media (max-height: 500px) and (orientation: landscape) { .modal-panel { max-height: 92vh; margin: auto; border-radius: var(--radius-lg); max-width: 90%; } }
</style>
</head>
<body>

<!-- 猫爪 SVG 定义 -->
<svg width="0" height="0" style="position:absolute;">
    <defs>
        <symbol id="paw" viewBox="0 0 24 24">
            <ellipse cx="6.5" cy="9.5" rx="2.3" ry="3"/>
            <ellipse cx="12" cy="7.5" rx="2.3" ry="3"/>
            <ellipse cx="17.5" cy="9.5" rx="2.3" ry="3"/>
            <ellipse cx="12" cy="17.5" rx="5.3" ry="4.2"/>
        </symbol>
    </defs>
</svg>

<canvas id="snow"></canvas>

<div class="shell">

    <nav class="nav">
        <span class="brand">
            <svg class="paw-icon" viewBox="0 0 24 24"><use href="#paw"/></svg>
            Snowfall<span class="dot">.</span>
        </span>
        <div class="actions">
            <button id="btnSnow" title="飘雪开关" aria-label="飘雪开关">
                <svg class="paw-mini" viewBox="0 0 24 24"><use href="#paw"/></svg>
            </button>
            <button id="btnManage" title="空间管理" aria-label="空间管理">✦</button>
        </div>
    </nav>

    <header class="hero">
        <p class="eyebrow">
            <svg class="paw-tiny" viewBox="0 0 24 24"><use href="#paw"/></svg>
            A LITTLE CORNER OF THE INTERNET
            <svg class="paw-tin
